<% layout('layouts/boilerplate') -%>
<main class="admin-pending-page host-review-page">
    <header class="admin-pending-header">
        <div>
            <p class="admin-eyebrow">Admin review</p>
            <h1><%= queueStatus === "approved" ? "Approved student verifications" : "Student verification requests" %></h1>
            <p class="admin-pending-intro"><%= queueStatus === "approved" ? "Browse users whose student or intern status has been verified." : "Review institution details and proof before allowing booking access for student and intern housing." %></p>
        </div>
        <nav class="admin-queue-tabs" aria-label="Student verification queues">
            <a class="<%= queueStatus === 'pending' ? 'is-active' : '' %>" href="/admin/students/pending">Pending</a>
            <a class="<%= queueStatus === 'approved' ? 'is-active' : '' %>" href="/admin/students/pending?status=approved">Approved</a>
        </nav>
        <span class="badge <%= queueStatus === 'approved' ? 'status-verified' : 'status-pending' %>"><span class="status-dot" aria-hidden="true"></span><%= pendingStudentVerifications.length %> <%= queueStatus === "approved" ? "approved" : "awaiting review" %></span>
    </header>

    <% if (!pendingStudentVerifications.length) { %>
        <section class="admin-empty-state" aria-live="polite">
            <span class="admin-empty-icon"><i class="fa-solid fa-user-check" aria-hidden="true"></i></span>
            <h2><%= queueStatus === "approved" ? "No approved verifications yet" : "Student review queue is clear" %></h2>
            <p><%= queueStatus === "approved" ? "Approved student verifications will appear here." : "New verification requests will appear here for review." %></p>
            <a class="btn btn-dark" href="/listings">View rooms</a>
        </section>
    <% } else { %>
        <section class="host-review-list" aria-label="Student verification applications awaiting review">
            <% pendingStudentVerifications.forEach(applicant => { %>
                <article class="host-review-card">
                    <div class="host-review-card-header">
                        <span class="host-review-avatar"><%= (applicant.name || applicant.username).slice(0, 1).toUpperCase() %></span>
                        <div>
                            <h2><%= applicant.name || applicant.username %></h2>
                            <p><%= applicant.email %> · Submitted <%= applicant.verificationSubmittedAt ? new Date(applicant.verificationSubmittedAt).toLocaleDateString() : "recently" %></p>
                        </div>
                        <span class="badge <%= queueStatus === 'approved' ? 'status-verified' : applicant.verificationStatus === 'needs_information' ? 'status-pending' : 'status-unverified' %>"><span class="status-dot" aria-hidden="true"></span><%= queueStatus === 'approved' ? 'Verified' : applicant.verificationStatus === 'needs_information' ? 'Needs information' : 'Pending' %></span>
                    </div>
                    <div class="host-review-grid">
                        <div><span>Institution</span><strong><%= applicant.institution || "Not provided" %></strong></div>
                        <div><span>Status type</span><strong><%= applicant.verificationType === "intern" ? "Intern" : applicant.verificationType === "other" ? "Other" : "Student" %></strong></div>
                        <div><span>Institutional email</span><strong><%= applicant.institutionEmail || "Not provided" %> <%= applicant.institutionEmailSignal === "recognized_domain" ? "· Recognized domain" : "· Manual review" %></strong></div>
                    </div>
                    <p class="host-review-note"><%= applicant.verificationNote || "No additional note provided." %></p>
                    <p class="host-review-note"><strong>Proof:</strong> <%= applicant.verificationDocs && applicant.verificationDocs.length ? applicant.verificationDocs[0] : "No proof provided." %></p>
                    <p class="host-review-note"><strong>Documents:</strong> <%= applicant.verificationDocs ? applicant.verificationDocs.length : 0 %> uploaded · Manual authenticity review required</p>
                    <% if (applicant.verificationAdminNote) { %><p class="host-review-admin-note"><i class="fa-solid fa-circle-info" aria-hidden="true"></i> <%= applicant.verificationAdminNote %></p><% } %>
                    <% if (queueStatus !== "approved") { %>
                    <div class="host-review-actions">
                        <form method="POST" action="/admin/students/<%= applicant._id %>/approve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-dark" type="submit"><i class="fa-solid fa-check" aria-hidden="true"></i> Approve verification</button></form>
                        <form method="POST" action="/admin/students/<%= applicant._id %>/needs-information"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-secondary" type="submit"><i class="fa-solid fa-message" aria-hidden="true"></i> Request information</button></form>
                        <form method="POST" action="/admin/students/<%= applicant._id %>/reject"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline-danger" type="submit"><i class="fa-solid fa-xmark" aria-hidden="true"></i> Reject</button></form>
                    </div>
                    <% } %>
                </article>
            <% }) %>
        </section>
    <% } %>
</main>
