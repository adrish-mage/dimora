<% layout('layouts/boilerplate') -%>
<main class="admin-pending-page verification-desk-page">
    <header class="admin-pending-header">
        <div>
            <p class="admin-eyebrow">Admin workspace</p>
            <h1>Verification desk</h1>
            <p class="admin-pending-intro">Review the people and rooms that make Dimora trustworthy.</p>
        </div>
    </header>

    <section class="verification-portals" aria-label="Verification portals">
        <% portals.forEach(portal => { %>
            <article class="verification-portal">
                <a class="verification-portal-main" href="<%= portal.pendingHref %>">
                    <span class="verification-portal-icon"><i class="fa-solid <%= portal.icon %>" aria-hidden="true"></i></span>
                    <span class="verification-portal-copy">
                        <strong><%= portal.title %></strong>
                        <span><%= portal.description %></span>
                    </span>
                    <i class="fa-solid fa-arrow-up-right-from-square verification-portal-arrow" aria-hidden="true"></i>
                </a>
                <div class="verification-portal-divider" aria-hidden="true"></div>
                <nav class="verification-portal-tabs" aria-label="<%= portal.title %> queues">
                    <a class="verification-portal-tab verification-portal-tab-active" href="<%= portal.pendingHref %>">
                        <span>Pending</span><strong><%= portal.pending %></strong>
                    </a>
                    <a class="verification-portal-tab" href="<%= portal.approvedHref %>">
                        <span>Approved</span><strong><%= portal.approved %></strong>
                    </a>
                </nav>
            </article>
        <% }) %>
    </section>
</main>
