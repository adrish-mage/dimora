<% layout('layouts/boilerplate') -%>

<main class="home-page">
    <section class="home-hero">
        <div class="home-hero-copy">
            <h1>Move cities.<br><em>Feel settled.</em></h1>
            <p class="home-hero-text">Find a furnished room for your semester or internship, with the details you need before you arrive.</p>
            <div class="home-actions">
                <a class="btn btn-dark btn-lg" href="/listings">Find a room <i class="fa-solid fa-arrow-right ms-2" aria-hidden="true"></i></a>
                <a class="home-secondary-link" href="<%= CurrUser && CurrUser.isVerifiedHost ? '/listings/new' : (CurrUser ? '/host/apply' : '/login') %>">Have a room to share? <span><%= CurrUser && CurrUser.isVerifiedHost ? 'Add a listing' : 'Become a host' %></span></a>
            </div>
            
        </div>
        <div class="home-hero-image">
            <img src="https://images.unsplash.com/photo-1522708323590-d24dbb6b0267?auto=format&fit=crop&w=1200&q=85" alt="A bright furnished room ready for a new resident">
            <div class="home-image-note">
                <span class="home-note-mark"><i class="fa-solid fa-location-dot" aria-hidden="true"></i></span>
                <span class="home-note-copy">
                    <strong>Start with where you are going</strong>
                    <small>Campus, workplace, and commute first.</small>
                    <span class="home-note-chip">12 min to campus</span>
                </span>
            </div>
        </div>
    </section>

    <section class="home-proof" aria-label="Why Dimora">
        <div>
            <p class="eyebrow">THE DIMORA DIFFERENCE</p>
            <h2>Every host checked.<br> Every room verified.</h2>
        </div>
        <div class="home-proof-copy">
            <p>Generic listing sites are built for short trips. Dimora is built for the uncertain months between accepting an offer and feeling at home in a new city.</p>
            <div class="home-pill-row">
                <span><i class="fa-solid fa-calendar-days" aria-hidden="true"></i> 1–6 month rooms</span>
                <span><i class="fa-solid fa-building-columns" aria-hidden="true"></i> Near campus or work</span>
                <span><i class="fa-solid fa-shield-heart" aria-hidden="true"></i> Built around trust</span>
            </div>
        </div>
    </section>
</main>