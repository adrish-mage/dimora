<% layout('layouts/boilerplate') -%>

<main class="dm-book">
    <header class="dm-book-head">
        <a class="dm-back" href="/listings/<%= listing._id %>"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> Back to listing</a>
        <h1>Request to book</h1>
        <p>Choose your lease dates and send a booking request to the host.</p>
    </header>

    <div class="dm-book-grid">
        <form method="POST" action="/booking/<%= listing._id %>/request-booking" novalidate class="needs-validation">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="dm-group">
                <h2>Lease dates</h2>
                <div class="dm-field-row">
                    <div class="dm-field">
                        <label for="checkIn">Check-in</label>
                        <input id="checkIn" name="booking[checkIn]" type="date" class="form-control" required>
                        <div class="invalid-feedback">Please select a check-in date.</div>
                    </div>

                    <div class="dm-field">
                        <label for="checkOut">Check-out</label>
                        <input id="checkOut" name="booking[checkOut]" type="date" class="form-control" required>
                        <div class="invalid-feedback">Please select a check-out date.</div>
                    </div>
                </div>
            </div>

            <div class="dm-group">
                <h2>Guest details</h2>
                <div class="dm-guest">
                    <dl>
                        <dt>Name</dt>
                        <dd><%= CurrUser.name || CurrUser.username || 'Guest' %></dd>
                    </dl>
                    <dl>
                        <dt>Email</dt>
                        <dd><%= CurrUser.email || 'No email on file' %></dd>
                    </dl>
                </div>

                <div class="dm-field">
                    <label for="guests">Number of guests</label>
                    <input id="guests" name="booking[guests]" type="number" min="1" value="1" class="form-control" required>
                    <div class="invalid-feedback">Please enter the number of guests.</div>
                </div>
            </div>

            <div class="dm-group">

                <div class="dm-field">
                    <label for="message" class="sr-only">Message to host</label>
                    <textarea id="message" name="booking[message]" class="form-control" rows="4" placeholder="Introduce yourself or leave a short note for the host..."></textarea>
                </div>
                <p class="dm-submit-note">You can update the dates and guest count before sending the request.</p>
            </div>

            <button class="dm-btn dm-btn-block" type="submit">Request to book</button>
        </form>

        <aside class="dm-lease" aria-label="Price summary">
            <img class="dm-lease-photo" src="<%= listing.image && listing.image.url ? listing.image.url : (typeof listing.image === 'string' ? listing.image : '') %>" alt="<%= listing.title %>">
            <div class="dm-lease-body">
                <h2><%= listing.title %></h2>
                <p class="dm-lease-place"><%= listing.location %>, <%= listing.country %></p>

                <dl class="dm-ledger">
                    <div>
                        <dt>Monthly rent</dt>
                        <span class="dm-leader" aria-hidden="true"></span>
                        <dd>₹<%= listing.price.toLocaleString('en-IN') %></dd>
                    </div>
                    <div>
                        <dt>Lease length</dt>
                        <span class="dm-leader" aria-hidden="true"></span>
                        <dd><span id="days">0</span> days</dd>
                    </div>
                    <div>
                        <dt>Base price</dt>
                        <span class="dm-leader" aria-hidden="true"></span>
                        <dd>₹<span id="base-price">0</span></dd>
                    </div>
                    <% if (listing.cleaningFee) { %>
                        <div>
                            <dt>Cleaning fee</dt>
                            <span class="dm-leader" aria-hidden="true"></span>
                            <dd>₹<%= listing.cleaningFee.toLocaleString('en-IN') %></dd>
                        </div>
                    <% } %>
                    <% if (listing.serviceFee) { %>
                        <div>
                            <dt>Service fee</dt>
                            <span class="dm-leader" aria-hidden="true"></span>
                            <dd>₹<%= listing.serviceFee.toLocaleString('en-IN') %></dd>
                        </div>
                    <% } %>
                    <div class="dm-total">
                        <dt>Total</dt>
                        <span class="dm-leader" aria-hidden="true"></span>
                        <dd>₹<span id="total-price">0</span></dd>
                    </div>
                </dl>

                <p class="dm-lease-note">Amounts are calculated using the selected lease dates and prorated rent. Any final total is confirmed by the host.</p>
            </div>
        </aside>
    </div>
</main>

<script>
    const checkIn = document.querySelector('#checkIn');
    const checkOut = document.querySelector('#checkOut');
    const daysElement = document.querySelector('#days');
    const basePriceElement = document.querySelector('#base-price');
    const totalPriceElement = document.querySelector('#total-price');

    const monthlyRate = <%= listing.price %>;
    const cleaningFee = <%= listing.cleaningFee || 0 %>;
    const serviceFee = <%= listing.serviceFee || 0 %>;

    function updatePrice() {
        if (!checkIn.value || !checkOut.value) return;

        const checkInDate = new Date(checkIn.value);
        const checkOutDate = new Date(checkOut.value);
        const days = (checkOutDate - checkInDate) / (1000 * 60 * 60 * 24);

        if (days <= 0) return;

        let fullMonths = 0;
        let current = new Date(checkInDate);
        while (true) {
            const next = new Date(current);
            next.setUTCMonth(next.getUTCMonth() + 1);
            if (next > checkOutDate) break;
            fullMonths += 1;
            current = next;
        }

        const extraDays = (checkOutDate - current) / (1000 * 60 * 60 * 24);
        const basePrice = fullMonths * monthlyRate + extraDays * (monthlyRate / 30);
        const total = basePrice + cleaningFee + serviceFee;

        daysElement.textContent = days;
        basePriceElement.textContent = basePrice.toLocaleString('en-IN');
        totalPriceElement.textContent = total.toLocaleString('en-IN');
    }

    checkIn.addEventListener('change', updatePrice);
    checkOut.addEventListener('change', updatePrice);
</script>