<% layout("layouts/boilerplate") %>

<% const pendingCount = bookings.filter(booking => booking.status === "pending").length; %>
<% const approvedCount = bookings.filter(booking => ["approved", "accepted"].includes(booking.status)).length; %>

<main class="dm-requests" data-host-bookings>
    <header class="dm-requests-head">
        <div>
            <a class="dm-back" href="<%= listing ? '/booking/view-bookings' : `/users/${CurrUser._id}` %>"><i class="fa-solid fa-arrow-left" aria-hidden="true"></i> <%= listing ? 'All listing bookings' : 'Back to profile' %></a>
            <h1><%= listing ? listing.title : 'Booking requests' %></h1>
            <p><%= listing ? 'Requests for this listing' : 'Requests across all your listings' %></p>
        </div>
        <div class="dm-head-links">
            <span class="dm-state" data-state="pending">Pending <strong><%= pendingCount %></strong></span>
            <span class="dm-state" data-state="approved">Approved <strong><%= approvedCount %></strong></span>
        </div>
    </header>

    <% if (bookings.length === 0) { %>
        <section class="dm-blank" aria-label="No booking requests">
            <h2>No requests yet</h2>
            <p>New booking requests will appear here once a guest sends one.</p>
        </section>
    <% } else { %>
        <div class="dm-tabs" role="tablist" aria-label="Filter requests">
            <button type="button" data-booking-filter="all" aria-pressed="true">All <span><%= bookings.length %></span></button>
            <button type="button" data-booking-filter="pending" aria-pressed="false">Pending <span><%= pendingCount %></span></button>
            <button type="button" data-booking-filter="approved" aria-pressed="false">Approved <span><%= approvedCount %></span></button>
            <button type="button" data-booking-filter="completed" aria-pressed="false">Completed <span><%= bookings.filter(booking => booking.status === 'completed').length %></span></button>
            <button type="button" data-booking-filter="rejected" aria-pressed="false">Rejected <span><%= bookings.filter(booking => booking.status === 'rejected').length %></span></button>
            <button type="button" data-booking-filter="cancelled" aria-pressed="false">Cancelled <span><%= bookings.filter(booking => booking.status === 'cancelled').length %></span></button>
        </div>

        <div class="dm-request-list">
            <% bookings.forEach(booking => { %>
                <% const guestName = booking.guest?.name || booking.guest?.username || 'Guest account unavailable'; %>
                <% const guestLink = booking.guest?._id ? `/users/${booking.guest._id}` : null; %>
                <% const bookingListing = listing || booking.listing; %>
                <% const listingImage = bookingListing?.image?.url || (typeof bookingListing?.image === 'string' ? bookingListing.image : ''); %>
                <% const bookingStatus = booking.status === 'accepted' ? 'approved' : (booking.status || 'pending'); %>
                <% const leaseEnded = new Date(booking.checkOut) <= new Date(); %>

                <article class="dm-request" data-booking-card data-status="<%= bookingStatus %>">
                    <a class="dm-request-photo" href="<%= bookingListing?._id ? `/listings/${bookingListing._id}` : '#' %>" aria-label="View listing">
                        <% if (listingImage) { %>
                            <img src="<%= listingImage %>" alt="<%= bookingListing?.title || 'Listing' %>">
                        <% } %>
                    </a>

                    <div>
                        <h2><a href="<%= bookingListing?._id ? `/listings/${bookingListing._id}` : '#' %>"><%= bookingListing?.title || 'Listing no longer available' %></a></h2>
                        <p class="dm-request-guest">
                            <% if (guestLink) { %>
                                <a href="<%= guestLink %>"><%= guestName %></a>
                            <% } else { %>
                                <%= guestName %>
                            <% } %>
                        </p>
                        <p class="dm-request-terms"><span>Lease</span> <%= new Date(booking.checkIn).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %> &ndash; <%= new Date(booking.checkOut).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></p>
                        <p class="dm-request-terms"><span>Guests</span> <%= booking.guests %> &bull; <span>Total</span> ₹<%= Number(booking.totalPrice || 0).toLocaleString('en-IN') %></p>
                        <% if (booking.message) { %>
                            <p class="dm-request-message"><%= booking.message %></p>
                        <% } %>
                    </div>

                    <div class="dm-request-side">
                        <span class="dm-state" data-state="<%= bookingStatus === 'approved' ? 'approved' : bookingStatus === 'completed' ? 'verified' : bookingStatus === 'rejected' ? 'rejected' : bookingStatus === 'cancelled' ? 'cancelled' : 'pending' %>"><%= bookingStatus %></span>
                        <div class="dm-request-actions">
                            <% if (bookingStatus === 'pending') { %>
                                <form method="POST" action="/booking/<%= booking._id %>/status">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="status" value="rejected">
                                    <input type="hidden" name="returnTo" value="<%= listing ? 'listing' : 'all' %>">
                                    <button class="dm-btn dm-btn-quiet" type="submit">Decline</button>
                                </form>
                                <form method="POST" action="/booking/<%= booking._id %>/status">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="status" value="approved">
                                    <input type="hidden" name="returnTo" value="<%= listing ? 'listing' : 'all' %>">
                                    <button class="dm-btn" type="submit">Accept</button>
                                </form>
                            <% } else if (bookingStatus === 'approved' && leaseEnded) { %>
                                <form method="POST" action="/booking/<%= booking._id %>/status">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="status" value="completed">
                                    <input type="hidden" name="returnTo" value="<%= listing ? 'listing' : 'all' %>">
                                    <button class="dm-btn" type="submit">Mark complete</button>
                                </form>
                            <% } else if (bookingStatus === 'approved') { %>
                                <form method="POST" action="/booking/<%= booking._id %>/status">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <input type="hidden" name="status" value="cancelled">
                                    <input type="hidden" name="returnTo" value="<%= listing ? 'listing' : 'all' %>">
                                    <button class="dm-btn dm-btn-quiet" type="submit">Cancel</button>
                                </form>
                            <% } %>
                        </div>
                    </div>
                </article>
            <% }) %>
        </div>

        <p class="dm-no-results" data-booking-empty-filter hidden>No requests match this status.</p>
    <% } %>
</main>

<script>
    (() => {
        const page = document.querySelector('[data-host-bookings]');
        if (!page) return;

        const cards = [...page.querySelectorAll('[data-booking-card]')];
        const filters = [...page.querySelectorAll('[data-booking-filter]')];
        const emptyMessage = page.querySelector('[data-booking-empty-filter]');

        filters.forEach(filter => {
            filter.addEventListener('click', () => {
                const status = filter.dataset.bookingFilter;
                let visibleCount = 0;

                cards.forEach(card => {
                    const isVisible = status === 'all' || card.dataset.status === status;
                    card.hidden = !isVisible;
                    if (isVisible) visibleCount += 1;
                });

                filters.forEach(option => option.setAttribute('aria-pressed', String(option === filter)));
                emptyMessage.hidden = visibleCount > 0;
            });
        });
    })();
</script>