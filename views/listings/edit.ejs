<% layout('layouts/boilerplate') -%>
<body>
    <div class="row form-page">
        <div class="col-8 offset-2">

            <h1 class="form-page-title">Edit this listing</h1>
            <p class="form-page-intro">Keep the details current so guests know what to expect.</p>
            <form method="POST" action="/listings/<%= listing._id %>?_method=PUT" novalidate class="needs-validation" enctype="multipart/form-data">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label for="title" class="form-label">Title</label>
                    <input 
                        id="title"
                        name="listing[title]" 
                        value="<%= listing.title %>" 
                        type="text"
                        class="form-control"
                        required
                    />
                    <div class="valid-feedback">Perfection</div>
                    <div class="invalid-feedback">Please enter a title.</div>
                </div>

                <div class="mb-3">
                    <label for="description" class="form-label">Description</label>
                    <textarea
                        name="listing[description]"
                        class="form-control"
                        required
                    ><%= listing.description %></textarea>
                    <div class="valid-feedback">Aptly described it.</div>
                    <div class="invalid-feedback">Please write something about it.</div>
                </div>
                
                <div class="mb-3">
                    <label for="price" class="form-label">Price</label>
                    <input 
                        id="price" 
                        name="listing[price]" 
                        value="<%= listing.price %>" 
                        type="number"
                        class="form-control"
                        required
                    >
                    <div class="valid-feedback">Absolutely worth it.</div>
                    <div class="invalid-feedback">How much?</div>
                </div>

                <div class="mb-3">
                    <label for="nearestCampus" class="form-label">Nearest campus</label>
                    <input
                        id="nearestCampus"
                        name="listing[nearestCampus]"
                        value="<%= listing.nearestCampus || '' %>"
                        type="text"
                        class="form-control"
                        required
                    >
                    <div class="valid-feedback">Perfect match.</div>
                    <div class="invalid-feedback">Which campus is closest?</div>
                </div>
                <div class="edit-image-section mb-4">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div>
                            <p class="edit-section-label mb-1">Listing image</p>
                            <p class="edit-section-help mb-0">A clear photo helps students picture the room.</p>
                        </div>
                        <span class="image-status-badge">Current</span>
                    </div>

                    <div class="image-preview-frame">
                        <img
                            id="image-preview"
                            src="<%= origImage %>"
                            alt="Current listing image"
                        >
                        <div class="image-preview-overlay">
                            <i class="fa-regular fa-image" aria-hidden="true"></i>
                            <span>Preview</span>
                        </div>
                    </div>

                    <div class="image-upload-row mt-3">
                        <label for="image" class="form-label mb-0">
                            <span class="d-block fw-semibold">Replace image</span>
                            <span class="image-upload-help">JPG or PNG, up to 5 MB</span>
                        </label>
                        <input
                            id="image"
                            name="listing[image]"
                            type="file"
                            class="form-control"
                            accept="image/png, image/jpeg"
                        />
                    </div>
                    <div class="valid-feedback">Looks beautiful.</div>
                    <div class="invalid-feedback">Can't see your amazing property!</div>
                </div>
                
                <div class="row">
                    <div class="mb-3 col-md-6">
                        <label for="location" class="form-label">Location</label>
                        <input 
                            id="location" 
                            name="listing[location]" 
                            value="<%= listing.location %>" 
                            type="text"
                            class="form-control"
                            required
                        >
                    </div>
                    
                    <div class="mb-3 col-md-6">
                        <label for="country" class="form-label">Country</label>
                        <input 
                            id="country" 
                            name="listing[country]" 
                            value="<%= listing.country %>" 
                            type="text"
                            class="form-control"
                            required
                        >
                    </div>
                </div>

                <button class="btn btn-dark">Edit</button>
                
            </form>
            
        </div>
    </div>
</body>
