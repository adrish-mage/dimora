<% layout('layouts/boilerplate') -%>

    <body>
        <div class="row form-page">
            <div class="col-8 offset-2">
            
            <h1 class="form-page-title">Create a new listing</h1>
            <p class="form-page-intro">Help a student or intern settle into the city for 1–6 months.</p>
                <form method="POST" action="/listings" novalidate class="needs-validation" enctype="multipart/form-data">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input 
                            id="title"
                            name="listing[title]" 
                            placeholder="e.g. Furnished room near campus" 
                            type="text"
                            class="form-control"
                            required
                        />
                        <div class="valid-feedback">Perfection</div>  
                        <div class="invalid-feedback">Please enter a title.</div>  
                    </div>
                    

                    
                    <div class="mb-3">
                        <textarea
                            name="listing[description]"
                            class="form-control"
                            placeholder="Describe the room, commute to campus or work, furnishings, and ideal lease length."
                            required
                        ></textarea>
                        <div class="valid-feedback">Aptly described it.</div>  
                        <div class="invalid-feedback">Please write something about it.</div> 
                    </div>
                    
                    <!-- <div class="mb-3">
                        <label for="image" class="form-label">Image Link</label>
                        <input 
                            id="image"
                            name="listing[image][url]" 
                            placeholder="enter image URL/Link" 
                            type="text" 
                            class="form-control"
                        />
                        <div class="valid-feedback">Looks beautiful.</div>
                        <div class="invalid-feedback">Can't see your amazing property!</div>
                    </div> -->
                    <div class="mb-3">
                        <label for="image" class="form-label">Upload Listing Image </label>
                        <input 
                            id="image"
                            name="listing[image]" 
                            type="file" 
                            class="form-control"
                            required
                        />
                        
                        <div class="valid-feedback">Looks beautiful.</div>
                        <div class="invalid-feedback">Can't see your amazing property!</div>
                    </div>

                    <div class="mb-3">
                        <label for="price" class="form-label">Monthly rent </label>
                        <input 
                            id="price" 
                            name="listing[price]" 
                            placeholder="&#8377;20,000 per month" 
                            type="number"
                            class="form-control"
                            required
                        >
                        <div class="valid-feedback">Absolutely worth it.</div>
                        <div class="invalid-feedback">How much? </div>
                    </div>

                    <div class="mb-3">
                        <label for="nearestCampus" class="form-label">Nearest campus</label>
                        <input
                            id="nearestCampus"
                            name="listing[nearestCampus]"
                            placeholder="e.g. IIT Delhi"
                            type="text"
                            class="form-control"
                            required
                        >
                        <div class="valid-feedback">Perfect match.</div>
                        <div class="invalid-feedback">Which campus is closest?</div>
                    </div>
                    
                    <div class="row">
                        <div class="mb-3 col-md-6">
                        <label for="location" class="form-label">Location</label>
                        <input 
                            id="location" 
                            name="listing[location]" 
                            placeholder="London" 
                            type="text"
                            class="form-control"
                            required
                        >
                        <div class="valid-feedback">Lovely Spot. </div>
                        <div class="invalid-feedback">Please disclose the Location.</div>
                    </div>
                    
                    
                    <div class="mb-3 col-md-6">
                        <label for="country" class="form-label">Country</label>
                        <input 
                            id="country" 
                            name="listing[country]" 
                            placeholder="United Kingdom" 
                            type="text"
                            class="form-control"
                            required
                        >
                        <div class="valid-feedback">Sounds Good.</div>
                        <div class="invalid-feedback">Which country is it?</div>
                    </div>
                    </div>
                    
                    
                
                    

                    
                    <button class = "btn btn-dark" >Add</button>

                </form>
            </div>
        </div>
    </body>
