<% layout('layouts/boilerplate') -%>
        <body>
            <% const verificationLabels = { unverified: "Not yet verified", pending: "Verification pending", verified: "Verified", flagged: "Flagged for review" }; %>
            <div class="listings-heading">
                <div>
                    
                    <h1><%= search ? 'Listings for "' + search + '"' : "Find your next listing in a new city." %></h1>
                    <p class="listings-intro"><%= search ? "Showing listings that match your search." : "Furnished listings for students and interns relocating for 1–6 months." %></p>
                </div>
                <span class="listing-count"><%= allListings.length %> listings</span>
            </div>
            <div class="filters">
                <a class="filter <%= !campus && !verified ? 'filter-active' : '' %>" href="/listings">
                    <i class="fa-solid fa-arrow-trend-up filter-icon"></i>
                    <p>All listings</p>
                </a>
                
                <a class="filter <%= verified && !campus ? 'filter-active' : '' %>" href="/listings?verified=true">
                    <i class="fa-solid fa-location-dot"></i>
                    <p>Verified only</p>
                </a>
                <% campusOptions.forEach((campusName) => { %>
                    <a class="filter <%= campus === campusName ? 'filter-active' : '' %>" href="/listings?campus=<%= encodeURIComponent(campusName) %>">
                        <i class="fa-solid fa-location-dot"></i>
                        <p><%= campusName %></p>
                    </a>
                <% }) %>
            </div>
            <% if (allListings.length) { %>
            <div class="row row-cols-xl-3 row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4 listings-grid">
                <% for(let listing of allListings) { %>
                    <a href="/listings/<%=listing._id%>" class="listing-link">
                        <div class="card col listing-card h-100">
                            <% const imgSrc=(listing && listing.image && listing.image.url) ? listing.image.url :
                                (typeof listing.image==='string' ? listing.image : '' ); %>
                                <div class="listing-image-wrap">
                                    <img src="<%=imgSrc %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy" />
                                    <span class="listing-image-label">Dimora listing</span>
                                    <span class="listing-verification-overlay status-<%= listing.verificationStatus %>"><%= verificationLabels[listing.verificationStatus] %></span>
                                </div>
                                <div class="card-body listing-card-body">
                                    <div class="listing-card-kicker">
                                        <span><i class="fa-solid fa-door-open" aria-hidden="true"></i> Listing in <%= listing.location %></span>
                                        <span class="listing-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
                                    </div>
                                    <div class="listing-card-title-row">
                                        <p class="card-text title mb-0"><b><%= listing.title %></b></p>
                                    </div>
                                    <div class="listing-meta-row">
                                        <p class="listing-price mb-0"><strong>&#8377;<%= listing.price.toLocaleString("en-IN") %></strong> <span>/ month</span></p>
                                        <span class="listing-lease"><i class="fa-regular fa-calendar" aria-hidden="true"></i> 1–6 month lease</span>
                                    </div>
                                    <% if (listing.nearestCampus) { %>
                                        <p class="listing-campus-meta"><i class="fa-solid fa-location-dot" aria-hidden="true"></i>Near to <%= listing.nearestCampus %></p>
                                    <% } %>
                                </div>
                        </div>
                    </a>

                    <% } %>
            </div>
            <% } else { %>
                <div class="listing-empty">
                    <i class="fa-solid fa-compass"></i>
                        <h2>No listings found</h2>
                    <p>Try a different city, campus, or workplace.</p>
                    <a class="btn btn-dark" href="/listings">View all listings</a>
                </div>
            <% } %>

