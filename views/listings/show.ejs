<% layout('layouts/boilerplate') -%>

        <div class="row mt-3 detail-page">
            <% const hostDisplayName = listing.owner.name || listing.owner.username || "Host"; %>
            <% const hostInitials = hostDisplayName.split(/\s+/).filter(Boolean).slice(0, 2).map(namePart => namePart.charAt(0).toUpperCase()).join(""); %>
            <aside class="listing-sidebar" aria-label="Listing summary">
                <div class="listing-summary-card">
                    <div class="sidebar-host">
                        <span class="sidebar-host-avatar" aria-hidden="true"><%= hostInitials %></span>
                        <div>
                            <a class="sidebar-host-name" href="/users/<%= listing.owner._id %>"><%= hostDisplayName %></a>
                            <% if (listing.owner.isVerifiedHost) { %>
                                <p class="sidebar-host-verification"><i class="fa-regular fa-circle-check" aria-hidden="true"></i> Identity verified</p>
                            <% } %>
                        </div>
                    </div>
                    <button class="sidebar-book-button" type="button">Request to book</button>
                </div>
            </aside>
            <div class="detail-main-column">
                <% const verificationLabels = { unverified: "Not yet verified", pending: "Verification pending", verified: "Verified", flagged: "Flagged for review" }; %>
                <h1 class="detail-title mb-3">
                    <%= listing.title %>
                </h1>
                <p class="detail-verification-caption <%= listing.verificationStatus === "verified" ? "detail-verification-caption-verified" : "" %>">
                    <span class="detail-verification-dot" aria-hidden="true"></span>
                    <%= verificationLabels[listing.verificationStatus] %>
                </p>

                <div class="card show-card">
                    <!-- Custom responsive show-img class handles framing -->
                    <% const imgSrc=(listing && listing.image && listing.image.url) ? listing.image.url : (typeof
                        listing.image==='string' ? listing.image : '' ); %>
                        <img src="<%= imgSrc %>" class="card-img-top show-img" alt="<%= listing.title %>">

                        <div class="listing-primary-meta">
                            <p class="listing-detail-price"><b>₹<%= listing.price.toLocaleString("en-IN") %></b><span>/ month</span></p>
                            <p class="listing-detail-location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i><%= listing.location %>, <%= listing.country %></p>
                        </div>

                        <div class="card-body px-0">
                            <% if (CurrUser && CurrUser._id.equals(listing.owner._id) && (listing.verificationStatus === "unverified" || listing.verificationStatus === "flagged")) { %>
                                <form method="POST" action="/listings/<%= listing._id %>/request-verification" class="mb-3">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="btn btn-dark" type="submit">Request verification</button>
                                </form>
                            <% } %>

                            <p class="card-text description-text mb-3">
                                <%= listing.description %>
                            </p>

                            <div class="d-flex justify-content-end align-items-start">
                                <%if (CurrUser && CurrUser._id.equals(listing.owner._id)){%>
                                    <div class="d-flex gap-2 align-items-start">
                                        <a href="/listings/<%=listing._id%>/edit" class="btn btn-dark btn-sm">Edit</a>
                                        <form method="POST" action="/listings/<%=listing._id%>?_method=DELETE"
                                            class="d-inline">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button class="btn btn-outline-danger btn-sm">Delete</button>
                                        </form>
                                    </div>
                                <%}%> 
                            </div>
                        </div>
                </div>
            </div>
            <section class="detail-reviews" aria-labelledby="reviews-title">
                        <hr>
                        <%if (CurrUser) { %>
                            <div class="col-10 offset-1 mb-4 mt-4 review-section">
                                <div class="submission-card card p-3 mb-4">
                                    <div class="card-body">
                                        <h4 class="mb-3">Leave a Review</h4>
                                        <form action="/listings/<%=listing._id%>/reviews" method="POST" class="needs-validation" novalidate>
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <input type="hidden" name="review[rating]" id="reviewRating" value="3">
                                            <div class="d-flex align-items-center mb-3">
                                                <label class="me-3 mb-0 fw-semibold">Rating</label>
                                                <div id="starControl" class="star-control">
                                                    <% for (let i = 1; i <= 5; i++) { %>
                                                        <i class="fa-regular fa-star star" data-value="<%= i %>"></i>
                                                    <% } %>
                                                </div>
                                            </div>
                                            <div class="mb-3">
                                                <label for="comment" class="form-label">Comments</label>
                                                <textarea class="form-control" name="review[comment]" id="comment" rows="4" placeholder="Share your experience" required></textarea>
                                                <div class="invalid-feedback">Please submit some feedback!</div>
                                            </div>
                                            <div class="d-flex justify-content-end">
                                                <button class="btn btn-primary" type="submit">Submit Review</button>
                                            </div>
                                        </form>
                                    </div>
                                </div>
                            <% } %>
                            <div class="reviews-heading"><p id="reviews-title" class="mb-0"><b>Guest notes</b> <span>(<%= listing.reviews ? listing.reviews.length : 0 %>)</span></p></div>
                            <div class="row g-4">
                                <% if (listing.reviews && listing.reviews.length) { %>
                                    <% for (const review of listing.reviews) { %>
                                        <div class="col-12 col-sm-6 mb-3">
                                            <div class="card review-card h-100 shadow-sm">
                                                <div class="card-body">
                                                    <div class="d-flex align-items-start mb-2">
                                                        <i class="fa-solid fa-user-circle fa-2x text-secondary me-3"></i>
                                                        <div>
                                                            <h6 class="reviewer-name mb-0"><%= review.author?.name || review.author?.username || "Anonymous" %>
</h6>
                                                            <small class="review-date text-muted"><%= new Date(review.createdAt).toLocaleDateString() %></small>
                                                        </div>
                                                        <div class="ms-auto review-stars">
                                                            <% for (let i = 1; i <= 5; i++) { %>
                                                                <i class="<%= i <= review.rating ? 'fa-solid fa-star text-warning' : 'fa-regular fa-star text-muted' %>"></i>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                    <p class="review-comment mb-0"><%= review.comment %></p>
                                                    <%if (CurrUser && review.author && CurrUser._id.equals(review.author._id)){%>
                                                        <form class="mb-3" method="POST" action="/listings/<%=listing._id%>/reviews/<%=review._id%>?_method=DELETE">
                                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                                            <button class="btn btn-dark" >Delete</button>
                                                        </form>
                                                    <%}%>
                                                    
                                                </div>
                                            </div>
                                        </div>
                                    <% } %>
                                <% } else { %>
                                    <div class="col-12"><p>No reviews yet.</p></div>
                                <% } %>
                            </div>
                            
                           
                            
                            
            </section>
        </div>
        
