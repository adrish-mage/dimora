<nav class="navbar navbar-expand-md sticky-top site-navbar">
  <div class="container">
    <a class="navbar-brand site-brand" href="/">
      <span class="brand-mark"><img src="/image.png" alt="Dimora logo"></span>
      <span>Dimora</span>
    </a>
    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation">
      <span class="navbar-toggler-icon" aria-hidden="true"></span>
    </button>
    <div class="collapse navbar-collapse" id="navbarNavAltMarkup">
      <div class="navbar-nav site-nav-links">
        <a class="nav-link <%= currentPath === '/' ? 'nav-link-active' : '' %>" href="/" <%= currentPath === '/' ? 'aria-current="page"' : '' %>>Home</a>
        <a class="nav-link <%= currentPath.startsWith('/listings') && !currentPath.includes('/new') ? 'nav-link-active' : '' %>" href="/listings" <%= currentPath.startsWith('/listings') && !currentPath.includes('/new') ? 'aria-current="page"' : '' %>>Find a room</a>
        <% if (CurrUser && CurrUser.isVerifiedHost) { %>
          <a class="nav-link nav-link-accent <%= currentPath === '/listings/new' ? 'nav-link-active' : '' %>" href="/listings/new" <%= currentPath === '/listings/new' ? 'aria-current="page"' : '' %>><i class="fa-solid fa-plus me-1" aria-hidden="true"></i>Add a listing</a>
        <% } else if (CurrUser && CurrUser.hostApplicationStatus === "pending") { %>
          <a class="nav-link nav-link-accent" href="/host/apply"><i class="fa-solid fa-hourglass-half me-1" aria-hidden="true"></i>Host application</a>
        <% } else if (CurrUser && CurrUser.hostApplicationStatus === "needs_information") { %>
          <a class="nav-link nav-link-accent" href="/host/apply"><i class="fa-solid fa-circle-exclamation me-1" aria-hidden="true"></i>Finish host application</a>
        <% } else if (CurrUser) { %>
          <a class="nav-link nav-link-accent" href="/host/apply"><i class="fa-solid fa-house-circle-check me-1" aria-hidden="true"></i>Become a host</a>
        <% } else { %>
          <a class="nav-link nav-link-accent" href="/login"><i class="fa-solid fa-house-circle-check me-1" aria-hidden="true"></i>Become a host</a>
        <% } %>
        <% if (CurrUser && CurrUser.verificationStatus !== "verified") { %>
          <a class="nav-link <%= currentPath === '/verify/student' ? 'nav-link-active' : '' %>" href="/verify/student" <%= currentPath === '/verify/student' ? 'aria-current="page"' : '' %>><i class="fa-solid fa-user-check me-1" aria-hidden="true"></i>Verify student status</a>
        <% } else if (CurrUser && CurrUser.verificationStatus === "verified") { %>
          <a class="nav-link <%= currentPath === '/verify/student' ? 'nav-link-active' : '' %>" href="/verify/student" <%= currentPath === '/verify/student' ? 'aria-current="page"' : '' %>><i class="fa-solid fa-circle-check me-1" aria-hidden="true"></i>Student verified</a>
        <% } %>
      </div>
      <form class="navbar-nav d-flex ms-auto navbar-search" role="search" action="/listings" method="GET">
        <input class="form-control me-2" type="search" name="q" value="<%= typeof search !== 'undefined' ? search : '' %>" placeholder="Search cities, campuses" aria-label="Search cities, campuses" autocomplete="off"/>
        <button class="btn btn-outline-success" type="submit" aria-label="Search cities and campuses">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
        </button>
      </form>
      <div class="navbar-nav ms-auto site-account-links">
        <%if (!CurrUser) {%>
        <a class="nav-link <%= currentPath === '/signup' ? 'nav-link-active' : '' %>" href="/signup">Sign up</a>
        <a class="nav-link <%= currentPath === '/login' ? 'nav-link-active' : '' %>" href="/login">Login</a>
        
        <%}%>
        <%if (CurrUser) {%>
        <% if (CurrUser.role === "admin") { %>
          <a class="nav-link" href="/admin/verification"><i class="fa-solid fa-shield-halved me-1" aria-hidden="true"></i>Verification desk</a>
        <% } %>
        <a class="profile-nav-link" href="/users/<%= CurrUser._id %>" aria-label="View your profile" title="View your profile">
          <i class="fa-regular fa-circle-user" aria-hidden="true"></i>
          <span>Profile</span>
        </a>
        <%}%>
        
      </div>
    </div>
  </div>
</nav>