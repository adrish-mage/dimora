<% layout('layouts/boilerplate') -%>

    <div class="auth-shell">
        <div class="auth-intro">
            <p class="eyebrow">WELCOME BACK</p>
            <h1>Make your next city feel livable.</h1>
            <p>Sign in to manage your rooms and keep your semester or internship move organized.</p>
        </div>
        <div class="auth-form-panel">
            <h2>Log in</h2>
            <form action="/login" method="POST" class="needs-validation" novalidate>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <div class="mb-3">
                    <label for="username" class="form-label">Username</label>
                    <input 
                        id="username"
                        name="username" 
                        type="text"
                        class="form-control"
                        required
                    />
                    <div class="valid-feedback">Looks good</div>  
                    <div class="invalid-feedback">Enter your username </div>  
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">password</label>
                    <input 
                        id="password"
                        name="password" 
                        type="password"
                        class="form-control"
                        required
                    />
                    <div class="valid-feedback">Looks good</div>  
                    <div class="invalid-feedback">Enter a strong password</div>  
                </div>
                <button class="btn btn-dark w-100">Login to my account</button>
            </form>
        </div>
    </div>