<% layout('layouts/boilerplate') -%>

<main class="dm-auth">
    <figure class="dm-auth-photo">
        <img src="https://images.unsplash.com/photo-1494526585095-c41746248156?auto=format&fit=crop&w=1200&q=85" alt="A modern furnished listing">
        <figcaption>Find a listing for your next semester or internship.</figcaption>
    </figure>

    <section class="dm-auth-main" aria-labelledby="signup-title">
        <h1 id="signup-title">Create your account</h1>
        <p class="dm-auth-lede">Set up your profile to start browsing listings or hosting students and interns.</p>

        <form action="/signup" method="POST" class="needs-validation" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="dm-field">
                <label for="name">Full name</label>
                <input id="name" name="name" type="text" class="form-control" autocomplete="name" required>
                <div class="invalid-feedback">Enter your name.</div>
            </div>

            <div class="dm-field">
                <label for="username">Username</label>
                <input id="username" name="username" type="text" class="form-control" autocomplete="username" required>
                <div class="invalid-feedback">Enter your username.</div>
            </div>

            <div class="dm-field">
                <label for="email">Email</label>
                <input id="email" name="email" type="email" class="form-control" autocomplete="email" required>
                <div class="invalid-feedback">Enter your email.</div>
            </div>

            <div class="dm-field">
                <label for="dob">Date of birth</label>
                <input id="dob" name="dob" type="date" class="form-control" autocomplete="bday" required>
                <div class="invalid-feedback">Enter your date of birth.</div>
            </div>

            <div class="dm-field">
                <label for="password">Password</label>
                <div class="dm-password">
                    <input id="password" name="password" type="password" class="form-control" autocomplete="new-password" required>
                    <button class="dm-reveal" type="button" data-reveal="password" aria-controls="password" aria-pressed="false">Show</button>
                </div>
                <div class="invalid-feedback">Enter a strong password.</div>
            </div>

            <button class="dm-btn dm-btn-block" type="submit">Create account</button>
        </form>

        <p class="dm-auth-switch">Already have an account? <a class="dm-link" href="/login">Log in</a></p>
    </section>
</main>
<script src="/js/auth.js" defer></script>