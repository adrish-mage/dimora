<% layout('layouts/boilerplate') -%>
<main class="profile-page">
    <div class="profile-shell">
        <section class="profile-header" aria-labelledby="profile-title">
            <div class="profile-identity">
                <span class="profile-avatar" aria-hidden="true"><i class="fa-regular fa-user"></i></span>
                <div class="profile-name-block">
                    <h1 id="profile-title"><%= user.name || user.username %></h1>
                    <p class="profile-username">@<%= user.username %></p>
                    <p class="profile-email"><%= user.email %></p>
                    <% if (user.isVerifiedHost) { %>
                        <span class="profile-verification"><i class="fa-solid fa-circle-check" aria-hidden="true"></i> Verified host</span>
                    <% } %>
                </div>
            </div>
            <% if (CurrUser && CurrUser._id.equals(user._id)) { %>
                <div class="profile-header-actions">
                    <a class="profile-logout-button" href="/logout">
                        <i class="fa-solid fa-arrow-right-from-bracket" aria-hidden="true"></i>
                        Log out
                    </a>
                </div>
            <% } %>
        </section>

        <section class="profile-stats" aria-label="Profile activity">
            <div>
                <strong><%= listings.length %></strong>
                <span><%= listings.length === 1 ? "Room" : "Rooms" %></span>
            </div>
            <div>
                <strong><%= reviews.length %></strong>
                <span><%= reviews.length === 1 ? "Review" : "Reviews" %></span>
            </div>
            <div>
                <strong><%= user.role %></strong>
                <span>Account type</span>
            </div>
        </section>

        <div class="profile-content-grid">
            <section class="profile-contact" aria-labelledby="profile-info-title">
                <h2 id="profile-info-title">Profile details</h2>
                <dl class="profile-details">
                    <div>
                        <dt>Name</dt>
                        <dd><%= user.name || "Not provided" %></dd>
                    </div>
                    <div>
                        <dt>Email</dt>
                        <dd><%= user.email %></dd>
                    </div>
                    <div>
                        <dt>Date of birth</dt>
                        <dd><%= user.dob ? new Date(user.dob).toLocaleDateString() : "Not provided" %></dd>
                    </div>
                    <div>
                        <dt>Institution / employer</dt>
                        <dd>
                            <%= user.institution || "Not provided" %>
                            <% if (user.institutionVerified) { %>
                                <span class="profile-detail-status"><i class="fa-solid fa-check" aria-hidden="true"></i> Verified</span>
                            <% } %>
                        </dd>
                    </div>
                </dl>
            </section>

            <div class="profile-main-column">
                <section class="profile-section profile-rooms" aria-labelledby="listings-title">
                    <div class="profile-section-heading">
                        <h2 id="listings-title">Rooms listed</h2>
                        <span class="section-count"><%= listings.length %></span>
                    </div>

                    <% if (listings.length === 0) { %>
                        <p class="profile-empty-state">No rooms listed yet.</p>
                    <% } %>
                    <div class="row row-cols-lg-2 row-cols-md-1 row-cols-sm-1 g-4 listings-grid profile-listings-grid">
                        <% listings.forEach(listing => { %>
                            <article class="card col listing-card h-100 profile-listing-card">
                                <a href="/listings/<%= listing._id %>" class="listing-link">
                                    <% const imgSrc=(listing && listing.image && listing.image.url) ? listing.image.url : (typeof listing.image === 'string' ? listing.image : ''); %>
                                    <div class="listing-image-wrap">
                                        <img src="<%= imgSrc %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy">
                                        <span class="listing-image-label">Dimora room</span>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between gap-3 align-items-start">
                                            <p class="card-text title mb-1"><b><%= listing.title %></b></p>
                                            <span class="listing-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
                                        </div>
                                        <div class="profile-listing-meta">
                                            <p class="listing-price mb-0">&#8377;<%= listing.price.toLocaleString("en-IN") %> <span>/ month</span></p>
                                            <span class="badge status-<%= listing.verificationStatus %>"><%= listing.verificationStatus %></span>
                                        </div>
                                    </div>
                                </a>
                                <% if (CurrUser && CurrUser._id.equals(user._id)) { %>
                                    <div class="profile-listing-actions">
                                        <a href="/listings/<%= listing._id %>/edit">Edit</a>
                                        <form method="POST" action="/listings/<%= listing._id %>?_method=DELETE">
                                            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                            <button type="submit">Delete</button>
                                        </form>
                                    </div>
                                <% } %>
                            </article>
                        <% }) %>
                    </div>
                </section>

                <section class="profile-section profile-reviews" aria-labelledby="reviews-title">
                    <div class="profile-section-heading">
                        <h2 id="reviews-title">Reviews by <%= user.username %></h2>
                        <span class="section-count"><%= reviews.length %></span>
                    </div>
                    <% if (reviews.length === 0) { %>
                        <p class="profile-empty-state">No reviews written yet.</p>
                    <% } %>
                    <div class="profile-review-list">
                        <% reviews.forEach(review => { %>
                            <article class="profile-review-card">
                                <p class="profile-review-context">On <a href="/listings/<%= review.listing?._id %>"><%= review.listing?.title || "a listing (deleted)" %></a></p>
                                <p class="profile-review-rating"><span aria-label="Rating: <%= review.rating %> out of 5"><%= "★".repeat(Number(review.rating) || 0) %></span> <%= review.rating %>/5</p>
                                <p class="profile-review-comment"><%= review.comment %></p>
                            </article>
                        <% }) %>
                    </div>
                </section>
            </div>
        </div>
    </div>
</main>