<% layout('layouts/boilerplate') -%>
<main class="profile-page <%= user.role === "admin" ? "admin-profile-page" : "" %>">
    <% const verificationLabels = { unverified: "Not yet verified", pending: "Verification pending", verified: "Verified", flagged: "Flagged for review" }; %>
    <% const isStudentVerified = user.verificationStatus === "verified"; %>
    <% const isHostApproved = user.isVerifiedHost || user.hostApplicationStatus === "approved"; %>
    <% const roleLabel = user.role === "admin" ? "Admin" : user.role === "host" ? "Host" : "Guest"; %>
    <% const profileRoleText = user.role === "admin" ? "Admin" : isStudentVerified && isHostApproved ? "Verified student + host" : isStudentVerified ? "Verified student" : isHostApproved ? "Host" : roleLabel; %>
    <% const studentStatusLabels = { unverified: "Not started", pending: "Pending review", verified: "Verified", rejected: "Rejected", needs_information: "Needs information" }; %>
    <% const hostStatusLabels = { not_started: "Not started", pending: "Pending review", approved: "Approved", rejected: "Rejected", needs_information: "Needs information" }; %>
    <% const studentStatus = isStudentVerified && user.verificationExpiresAt && new Date(user.verificationExpiresAt) <= new Date() ? "Expired" : studentStatusLabels[user.verificationStatus] || "Not started"; %>
    <% const hostStatus = isHostApproved ? "Approved" : hostStatusLabels[user.hostApplicationStatus] || "Not started"; %>
    <div class="profile-shell">
        <section class="profile-header" aria-labelledby="profile-title">
            <div class="profile-identity">
                
                <div class="profile-name-block">
                    <h1 id="profile-title"><%= user.name || user.username %></h1>
                    <p class="profile-username">@<%= user.username %></p>
                    <div class="profile-verification-list" aria-label="Profile verification statuses">
                        <span class="profile-verification <%= isStudentVerified ? '' : 'is-muted' %>"><i class="fa-solid <%= isStudentVerified ? 'fa-circle-check' : 'fa-user-check' %>" aria-hidden="true"></i> Student: <%= studentStatus %></span>
                        <span class="profile-verification host-pill <%= isHostApproved ? '' : 'is-muted' %>"><i class="fa-solid <%= isHostApproved ? 'fa-house-circle-check' : 'fa-house' %>" aria-hidden="true"></i> Host: <%= hostStatus %></span>
                    </div>
                </div>
            </div>
            <% if (CurrUser && CurrUser._id.equals(user._id)) { %>
                <div class="profile-header-actions">
                    <% if (user.role === "admin") { %>
                        <a class="profile-admin-link" href="/admin/verification">
                            <i class="fa-solid fa-shield-halved" aria-hidden="true"></i>
                            Verification desk
                        </a>
                    <% } %>
                    <a class="profile-logout-button" href="/logout">
                        
                        LOG OUT
                    </a>
                </div>
            <% } %>
        </section>

        <section class="profile-stats" aria-label="Profile activity">
            <div>
                <strong><%= listings.length %></strong>
                <span><%= listings.length === 1 ? "Room" : "Rooms" %></span>
            </div>
            <div>
                <strong><%= reviews.length %></strong>
                <span><%= reviews.length === 1 ? "Review" : "Reviews" %></span>
            </div>
            <div>
                <strong><%= profileRoleText %></strong>
                <span>Profile type</span>
            </div>
        </section>

        <% if (user.role === "admin" && CurrUser && CurrUser._id.equals(user._id)) { %>
            <section class="admin-profile-tools" aria-labelledby="admin-tools-title">
                <div>
                    <p class="admin-eyebrow">Workspace</p>
                    <h2 id="admin-tools-title">Verification desk</h2>
                    <p>Review people and rooms that make Dimora trustworthy.</p>
                </div>
                <a class="admin-profile-tool-link" href="/admin/verification">
                    <span class="admin-profile-tool-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
                    <span>
                        <strong>Open verification desk</strong>
                        <small>View all verification portals</small>
                    </span>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
            </section>
            <section class="profile-verification-portals" aria-label="Verification portals">
                <% verificationPortals.forEach(portal => { %>
                    <article class="verification-portal">
                        <a class="verification-portal-main" href="<%= portal.pendingHref %>">
                            <span class="verification-portal-icon"><i class="fa-solid <%= portal.icon %>" aria-hidden="true"></i></span>
                            <span class="verification-portal-copy">
                                <strong><%= portal.title %></strong>
                                <span><%= portal.description %></span>
                            </span>
                            <i class="fa-solid fa-arrow-up-right-from-square verification-portal-arrow" aria-hidden="true"></i>
                        </a>
                        <div class="verification-portal-divider" aria-hidden="true"></div>
                        <nav class="verification-portal-tabs" aria-label="<%= portal.title %> queues">
                            <a class="verification-portal-tab verification-portal-tab-active" href="<%= portal.pendingHref %>"><span>Pending</span><strong><%= portal.pending %></strong></a>
                            <a class="verification-portal-tab" href="<%= portal.approvedHref %>"><span>Approved</span><strong><%= portal.approved %></strong></a>
                        </nav>
                    </article>
                <% }) %>
            </section>
        <% } %>

        <div class="profile-content-grid">
            <section class="profile-contact" aria-labelledby="profile-info-title">
                <h2 id="profile-info-title">Profile details</h2>
                <br>
                <dl class="profile-details">
                    <div>
                        <dt>Name</dt>
                        <dd><%= user.name || "Not provided" %></dd>
                    </div>
                    <div>
                        <dt>Email</dt>
                        <dd><%= user.email %></dd>
                    </div>
                    <div>
                        <dt>Date of birth</dt>
                        <dd><%= user.dob ? new Date(user.dob).toLocaleDateString() : "Not provided" %></dd>
                    </div>
                    <div>
                        <dt>Institution / employer</dt>
                        <dd>
                            <%= user.institution || "Not provided" %>
                            <% if (user.institutionVerified) { %>
                                <span class="profile-detail-status"><i class="fa-solid fa-check" aria-hidden="true"></i> Verified</span>
                            <% } %>
                        </dd>
                    </div>
                    <div>
                        <dt>Student verification</dt>
                        <dd>
                            <%= studentStatus %>
                            <% if (user.verificationExpiresAt && isStudentVerified) { %>
                                <small class="profile-status-meta">Until <%= new Date(user.verificationExpiresAt).toLocaleDateString() %></small>
                            <% } %>
                        </dd>
                    </div>
                    <div>
                        <dt>Host approval</dt>
                        <dd><%= hostStatus %></dd>
                    </div>
                    <div>
                        <dt>Account role</dt>
                        <dd><%= roleLabel %></dd>
                    </div>
                    <% if (isStudentVerified && isHostApproved) { %>
                    <div>
                        <dt>Combined access</dt>
                        <dd>Verified student + host</dd>
                    </div>
                    <% } %>
                </dl>
            </section>

            <div class="profile-main-column">
                <section class="profile-section profile-rooms" aria-labelledby="listings-title">
                    <div class="profile-section-heading">
                        <h2 id="listings-title">Rooms listed</h2>
                        <span class="section-count"><%= listings.length %></span>
                    </div>

                    <% if (listings.length === 0) { %>
                        <p class="profile-empty-state">No rooms listed yet.</p>
                    <% } %>
                    <div class="row row-cols-lg-2 row-cols-md-1 row-cols-sm-1 g-4 listings-grid profile-listings-grid">
                        <% listings.forEach(listing => { %>
                            <article class="card col listing-card h-100 profile-listing-card">
                                <a href="/listings/<%= listing._id %>" class="listing-link">
                                    <% const imgSrc=(listing && listing.image && listing.image.url) ? listing.image.url : (typeof listing.image === 'string' ? listing.image : ''); %>
                                    <div class="listing-image-wrap">
                                        <img src="<%= imgSrc %>" class="card-img-top" alt="<%= listing.title %>" loading="lazy">
                                        <span class="listing-image-label">Dimora room</span>
                                        <span class="listing-verification-overlay status-<%= listing.verificationStatus %>"><%= verificationLabels[listing.verificationStatus] %></span>
                                    </div>
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between gap-3 align-items-start">
                                            <p class="card-text title mb-1"><b><%= listing.title %></b></p>
                                            <span class="listing-arrow" aria-hidden="true"><i class="fa-solid fa-arrow-up-right-from-square"></i></span>
                                        </div>
                                        <div class="profile-listing-meta">
                                            <p class="listing-price mb-0">&#8377;<%= listing.price.toLocaleString("en-IN") %> <span>/ month</span></p>
                                            <span class="badge status-<%= listing.verificationStatus %>"><span class="status-dot" aria-hidden="true"></span><%= verificationLabels[listing.verificationStatus] %></span>
                                        </div>
                                    </div>
                                </a>
                                
                            </article>
                        <% }) %>
                    </div>
                </section>

                <section class="profile-section profile-reviews" aria-labelledby="reviews-title">
                    <div class="profile-section-heading">
                        <h2 id="reviews-title">Reviews by <%= user.username %></h2>
                        <span class="section-count"><%= reviews.length %></span>
                    </div>
                    <% if (reviews.length === 0) { %>
                        <p class="profile-empty-state">No reviews written yet.</p>
                    <% } %>
                    <div class="profile-review-list">
                        <% reviews.forEach(review => { %>
                            <article class="profile-review-card">
                                <p class="profile-review-context">On <a href="/listings/<%= review.listing?._id %>"><%= review.listing?.title || "a listing (deleted)" %></a></p>
                                <p class="profile-review-rating"><span aria-label="Rating: <%= review.rating %> out of 5"><%= "★".repeat(Number(review.rating) || 0) %></span> <%= review.rating %>/5</p>
                                <p class="profile-review-comment"><%= review.comment %></p>
                            </article>
                        <% }) %>
                    </div>
                </section>
            </div>
        </div>
    </div>
</main>