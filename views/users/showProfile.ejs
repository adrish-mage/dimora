<% layout('layouts/boilerplate') -%>
<%
    const isOwn = !!(CurrUser && CurrUser._id.equals(user._id));
    const isAdmin = user.role === "admin";
    const isOwnAdmin = isAdmin && isOwn;
    const isStudentVerified = user.verificationStatus === "verified";
    const isHostApproved = user.isVerifiedHost || user.hostApplicationStatus === "approved";
    const studentExpired = isStudentVerified && user.verificationExpiresAt && new Date(user.verificationExpiresAt) <= new Date();
    const fmtDate = (value, opts) => new Date(value).toLocaleDateString("en-IN", opts || { day: "numeric", month: "short", year: "numeric" });

    const roleLabel = isAdmin ? "Admin" : user.role === "host" ? "Host" : "Guest";
    const roleText = isAdmin ? "Admin" : isStudentVerified && isHostApproved ? "Verified student and host" : isStudentVerified ? "Verified student" : isHostApproved ? "Host" : roleLabel;

    const studentLabels = { unverified: "Not started", pending: "Pending review", verified: "Verified", rejected: "Rejected", needs_information: "Needs more information" };
    const hostLabels = { not_started: "Not started", pending: "Pending review", approved: "Approved", rejected: "Rejected", needs_information: "Needs more information" };

    let studentState = user.verificationStatus || "unverified";
    let studentText = studentLabels[studentState] || "Not started";
    if (studentExpired) { studentState = "rejected"; studentText = "Expired"; }
    else if (isStudentVerified && user.verificationExpiresAt) { studentText = "Verified until " + fmtDate(user.verificationExpiresAt); }

    const hostState = isHostApproved ? "approved" : (user.hostApplicationStatus || "not_started");
    const hostText = isHostApproved ? "Approved" : (hostLabels[hostState] || "Not started");

    const verificationLabels = { unverified: "Not yet verified", pending: "Verification pending", verified: "Verified", flagged: "Flagged for review" };
    const plural = (n, one, many) => n + " " + (n === 1 ? one : many);
    const initials = (user.name || user.username || "?").trim().split(/\s+/).slice(0, 2).map(w => w[0]).join("").toUpperCase();
%>

<main class="dm-profile">
    <header class="dm-profile-head">

        <div class="dm-head-text">
            <h1><%= user.name || user.username %></h1>
            <p class="dm-handle">@<%= user.username %></p>

        </div>
        <% if (isOwn) { %>
            <div class="dm-head-links">
                <a class="dm-btn dm-btn-quiet" href="/logout">Log out</a>
            </div>
        <% } %>
    </header>

    <% if (isOwnAdmin) { %>
        <div class="dm-orig">
            <section class="admin-profile-tools" aria-labelledby="admin-tools-title">
                <div>
                    <p class="admin-eyebrow">Workspace</p>
                    <h2 id="admin-tools-title">Verification desk</h2>
                    <p>Review people and rooms that make Dimora trustworthy.</p>
                </div>
                <a class="admin-profile-tool-link" href="/admin/verification">
                    <span class="admin-profile-tool-icon"><i class="fa-solid fa-shield-halved" aria-hidden="true"></i></span>
                    <span>
                        <strong>Open verification desk</strong>
                        <small>View all verification portals</small>
                    </span>
                    <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
                </a>
            </section>
            <section class="profile-verification-portals" aria-label="Verification portals">
                <% verificationPortals.forEach(portal => { %>
                    <article class="verification-portal">
                        <a class="verification-portal-main" href="<%= portal.pendingHref %>">
                            <span class="verification-portal-icon"><i class="fa-solid <%= portal.icon %>" aria-hidden="true"></i></span>
                            <span class="verification-portal-copy">
                                <strong><%= portal.title %></strong>
                                <span><%= portal.description %></span>
                            </span>
                            <i class="fa-solid fa-arrow-up-right-from-square verification-portal-arrow" aria-hidden="true"></i>
                        </a>
                        <div class="verification-portal-divider" aria-hidden="true"></div>
                        <nav class="verification-portal-tabs" aria-label="<%= portal.title %> queues">
                            <a class="verification-portal-tab verification-portal-tab-active" href="<%= portal.pendingHref %>"><span>Pending</span><strong><%= portal.pending %></strong></a>
                            <a class="verification-portal-tab" href="<%= portal.approvedHref %>"><span>Approved</span><strong><%= portal.approved %></strong></a>
                        </nav>
                    </article>
                <% }) %>
            </section>
        </div>
    <% } else { %>
    <div class="dm-profile-grid">
        <aside class="dm-side">
            <section class="dm-block" aria-labelledby="checks-title">
                <h2 id="checks-title">Verification</h2>
                <ul class="dm-checks">
                    <li data-state="<%= studentState %>">
                        <span class="dm-check-mark" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5l2.2 2.2L9.5 3.8"/></svg></span>
                        <div>
                            <strong>Student or intern</strong>
                            <span class="dm-check-text"><%= studentText %></span>
                            <% if (isOwn && ["unverified", "rejected", "needs_information"].includes(user.verificationStatus || "unverified") || (isOwn && studentExpired)) { %>
                                <a class="dm-link" href="/verify/student">Verify student status</a>
                            <% } %>
                        </div>
                    </li>
                    <li data-state="<%= hostState %>">
                        <span class="dm-check-mark" aria-hidden="true"><svg viewBox="0 0 12 12" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2.5 6.5l2.2 2.2L9.5 3.8"/></svg></span>
                        <div>
                            <strong>Host</strong>
                            <span class="dm-check-text"><%= hostText %></span>
                            <% if (isOwn && !isHostApproved) { %>
                                <a class="dm-link" href="/host/apply"><%= hostState === "pending" ? "View application" : hostState === "needs_information" ? "Finish application" : "Apply to host" %></a>
                            <% } %>
                        </div>
                    </li>
                </ul>
            </section>

            <% if (isOwn) { %>
            <section class="dm-block" aria-labelledby="facts-title">
                <h2 id="facts-title">Your details</h2>
                <dl class="dm-facts">
                    <div><dt>Email</dt><dd><%= user.email %></dd></div>
                    <div><dt>Date of birth</dt><dd><%= user.dob ? fmtDate(user.dob, { day: "numeric", month: "long", year: "numeric" }) : "Not provided" %></dd></div>
                </dl>
            </section>
            <% } %>
        </aside>

        <div>
            <div class="dm-orig">
                <section class="profile-section profile-rooms" aria-labelledby="listings-title">
                    <div class="profile-section-heading">
                        <h2 id="listings-title">Rooms listed <small style="opacity: .8;">(<%= listings.length %>)</small></h2>

                    </div>
                    <% if (isHostApproved && isOwn) { %>
                        <p><a class="btn btn-dark" href="/booking/view-bookings">View all room bookings</a></p>
                    <% } %>

                    <% if (listings.length === 0) { %>
                        <p class="profile-empty-state">No rooms listed yet.</p>
                    <% } %>
                    <section class="admin-review-list profile-listing-bars" aria-label="Rooms listed by <%= user.username %>">
                        <% listings.forEach(listing => { %>
                            <article class="admin-review-item profile-listing-bar">
                                <% const imgSrc = (listing && listing.image && listing.image.url) ? listing.image.url : (typeof listing.image === "string" ? listing.image : ""); %>

                                <a class="admin-review-image-link" href="/listings/<%= listing._id %>" aria-label="View <%= listing.title %>">
                                    <img class="admin-review-image" src="<%= imgSrc %>" alt="<%= listing.title %>" loading="lazy">
                                    <span class="listing-verification-overlay status-<%= listing.verificationStatus %>">
                                        <%= verificationLabels[listing.verificationStatus] %>
                                    </span>
                                </a>

                                <div class="admin-review-details">
                                    <div>
                                        <h2><a href="/listings/<%= listing._id %>"><%= listing.title %></a></h2>
                                        <p class="admin-review-location"><%= listing.location %></p>
                                    </div>

                                    <dl>
                                        <div>
                                            <dt>Price</dt>
                                            <dd>&#8377;<%= listing.price.toLocaleString("en-IN") %> / month</dd>
                                        </div>
                                        <div>
                                            <dt>Status</dt>
                                            <dd>
                                                <span class="badge status-<%= listing.verificationStatus %>">
                                                    <span class="status-dot" aria-hidden="true"></span>
                                                    <%= verificationLabels[listing.verificationStatus] %>
                                                </span>
                                            </dd>
                                        </div>
                                    </dl>
                                </div>

                                <div class="admin-review-actions">
                                    <a class="btn btn-dark" href="/listings/<%= listing._id %>">View Room</a>
                                    <% if (isHostApproved && isOwn) { %>
                                        <a class="btn btn-outline-dark" href="/booking/<%= listing._id %>/view-booking">View Bookings</a>
                                    <% } %>
                                </div>
                            </article>
                        <% }) %>
                    </section>
                </section>

            </div>

            <section class="dm-section" aria-labelledby="reviews-title">
                <div class="dm-section-head">
                    <h2 id="reviews-title">Reviews written<span><%= reviews.length %></span></h2>
                </div>

                <% if (reviews.length === 0) { %>
                    <p class="dm-empty"><%= isOwn ? "Reviews you write will show up here." : "No reviews written yet." %></p>
                <% } %>

                <% reviews.forEach(review => { %>
                    <article class="dm-review">
                        <div class="dm-review-top">
                            <% if (review.listing && review.listing._id) { %>
                                <a href="/listings/<%= review.listing._id %>"><%= review.listing.title %></a>
                            <% } else { %>
                                <a href="#" tabindex="-1" aria-disabled="true" style="pointer-events: none;">Room no longer listed</a>
                            <% } %>
                            <span><%= Number(review.rating) || 0 %> out of 5</span>
                        </div>
                        <p><%= review.comment %></p>
                    </article>
                <% }) %>
            </section>
        </div>
    </div>
    <% } %>
</main>
